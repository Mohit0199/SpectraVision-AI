---
import { UploadCloud, Image as ImageIcon, Sparkles, AlertTriangle, CheckCircle2, ShieldAlert } from 'lucide-astro';
---

<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 mb-10">
  
  <!-- Upload Container -->
  <div 
    id="dropzone"
    class="relative group rounded-xl border border-dashed border-neutral-700/80 bg-neutral-950/70 hover:bg-neutral-900/50 hover:border-neutral-500 transition-all duration-300 p-8 sm:p-10 text-center cursor-pointer shadow-[0_4px_30px_rgba(0,0,0,0.5)] overflow-hidden"
  >
    <!-- Scanning Radar Grid Line (Hidden by default, shown during analysis) -->
    <div id="scanline-overlay" class="hidden absolute inset-0 bg-gradient-to-b from-cyan-500/0 via-cyan-500/15 to-cyan-500/0 pointer-events-none animate-scanline z-20"></div>

    <!-- Hidden native file input -->
    <input 
      type="file" 
      id="file-input" 
      accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif,.jpg,.jpeg,.png,.webp" 
      class="hidden" 
    />

    <!-- Upload Content State -->
    <div id="dropzone-default" class="flex flex-col items-center justify-center gap-3">
      <div class="w-14 h-14 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-cyan-400 group-hover:border-cyan-500/50 transition-colors shadow-inner">
        <UploadCloud class="w-7 h-7 transition-transform group-hover:-translate-y-0.5" />
      </div>
      
      <div class="flex flex-col gap-1">
        <p class="text-sm font-medium text-white">
          <span class="text-cyan-400 underline decoration-cyan-500/50 underline-offset-4">Click to upload</span> or drag and drop suspect media
        </p>
        <p class="text-xs text-neutral-400 font-mono">
          Supports JPEG, PNG, WebP, HEIC/iPhone (Max 25MB) • Local Forensic Engine
        </p>
      </div>
    </div>

    <!-- Analyzing Progress State (Hidden by default) -->
    <div id="dropzone-analyzing" class="hidden flex-col items-center justify-center gap-4 py-4">
      <div class="relative w-12 h-12">
        <div class="w-12 h-12 rounded-full border-2 border-neutral-800 border-t-cyan-400 animate-spin"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <Sparkles class="w-5 h-5 text-cyan-400 animate-pulse" />
        </div>
      </div>
      <div class="flex flex-col gap-1.5 items-center">
        <p id="analysis-step-text" class="text-sm font-mono text-cyan-300">Computing 2D-FFT Spectral Harmonics...</p>
        <div class="w-64 h-1.5 bg-neutral-900 rounded-full overflow-hidden border border-neutral-800">
          <div id="analysis-progress-bar" class="h-full bg-gradient-to-r from-cyan-500 to-indigo-500 w-1/3 transition-all duration-300"></div>
        </div>
        <span class="text-[11px] text-neutral-400 font-mono">Executing 4-layer multi-signal decomposition</span>
      </div>
    </div>

  </div>

  <!-- 1-Click Preset Reference Samples -->
  <div class="mt-6 flex flex-col gap-2.5">
    <div class="flex items-center justify-between">
      <span class="text-xs font-mono uppercase tracking-wider text-neutral-400">Or test with calibrated benchmark samples:</span>
      <span class="text-[11px] text-neutral-400 font-mono">1-click instant audit</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      
      <!-- Sample 1: Authentic -->
      <button 
        data-sample-id="sample-authentic" 
        class="sample-btn text-left p-3 rounded-lg bg-neutral-950 border border-neutral-800 hover:border-emerald-500/60 hover:bg-neutral-900 transition-all flex items-start gap-3 group"
      >
        <div class="w-8 h-8 rounded bg-emerald-950/60 border border-emerald-800/60 flex items-center justify-center text-emerald-400 shrink-0 mt-0.5">
          <CheckCircle2 class="w-4 h-4" />
        </div>
        <div class="flex flex-col overflow-hidden">
          <div class="flex items-center justify-between gap-1">
            <span class="text-xs font-medium text-white truncate group-hover:text-emerald-300">Authentic Camera</span>
            <span class="text-[9px] px-1 py-0.2 rounded bg-neutral-900 text-neutral-400 font-mono shrink-0">Sony A7</span>
          </div>
          <span class="text-[11px] text-neutral-400 leading-snug truncate mt-0.5">Physical CMOS photon noise</span>
        </div>
      </button>

      <!-- Sample 2: Diffusion AI -->
      <button 
        data-sample-id="sample-diffusion" 
        class="sample-btn text-left p-3 rounded-lg bg-neutral-950 border border-neutral-800 hover:border-cyan-500/60 hover:bg-neutral-900 transition-all flex items-start gap-3 group"
      >
        <div class="w-8 h-8 rounded bg-cyan-950/60 border border-cyan-800/60 flex items-center justify-center text-cyan-400 shrink-0 mt-0.5">
          <Sparkles class="w-4 h-4" />
        </div>
        <div class="flex flex-col overflow-hidden">
          <div class="flex items-center justify-between gap-1">
            <span class="text-xs font-medium text-white truncate group-hover:text-cyan-300">Diffusion Portrait</span>
            <span class="text-[9px] px-1 py-0.2 rounded bg-neutral-900 text-neutral-400 font-mono shrink-0">Midjourney v6</span>
          </div>
          <span class="text-[11px] text-neutral-400 leading-snug truncate mt-0.5">Upsampling periodic grid</span>
        </div>
      </button>

      <!-- Sample 3: FaceSwap Deepfake -->
      <button 
        data-sample-id="sample-faceswap" 
        class="sample-btn text-left p-3 rounded-lg bg-neutral-950 border border-neutral-800 hover:border-rose-500/60 hover:bg-neutral-900 transition-all flex items-start gap-3 group"
      >
        <div class="w-8 h-8 rounded bg-rose-950/60 border border-rose-800/60 flex items-center justify-center text-rose-400 shrink-0 mt-0.5">
          <ShieldAlert class="w-4 h-4" />
        </div>
        <div class="flex flex-col overflow-hidden">
          <div class="flex items-center justify-between gap-1">
            <span class="text-xs font-medium text-white truncate group-hover:text-rose-300">FaceSwap Spliced</span>
            <span class="text-[9px] px-1 py-0.2 rounded bg-neutral-900 text-neutral-400 font-mono shrink-0">DeepFaceLab</span>
          </div>
          <span class="text-[11px] text-neutral-400 leading-snug truncate mt-0.5">Seam blur & ELA delta</span>
        </div>
      </button>

    </div>
  </div>

</div>
