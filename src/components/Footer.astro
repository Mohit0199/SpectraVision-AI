---
import { ShieldCheck } from 'lucide-astro';
---

<footer class="w-full border-t border-neutral-800/80 bg-black/90 py-8 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
    
    <!-- Brand Info -->
    <div class="flex items-center gap-2">
      <ShieldCheck class="w-4 h-4 text-cyan-400" />
      <span class="font-semibold text-sm tracking-tight text-white">SPECTRAVISION FORENSICS</span>
      <span class="text-[10px] text-neutral-400 font-mono">v1.0.0</span>
    </div>

    <!-- Right Side Attribution / Status -->
    <div class="text-xs text-neutral-400 font-mono">
      <span>Explainable Multi-Signal Synthetic Media Verification System</span>
    </div>

  </div>
</footer>
