---
import { ShieldCheck } from 'lucide-astro';
---

<header class="w-full border-b border-neutral-800/80 bg-black/70 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Logo & Title -->
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-neutral-900 border border-neutral-700/80 flex items-center justify-center text-cyan-400 shadow-[0_0_15px_rgba(0,242,254,0.15)]">
        <ShieldCheck class="w-5 h-5 text-cyan-400" />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-base tracking-tight text-white">SPECTRAVISION</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-cyan-950/60 text-cyan-300 font-mono border border-cyan-800/50">FORENSICS</span>
        </div>
        <span class="text-[11px] text-neutral-400 font-mono -mt-0.5">Synthetic Media Verification Engine</span>
      </div>
    </div>

    <!-- Right Side Status Pill -->
    <div class="flex items-center gap-4 sm:gap-6">
      <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900/90 border border-neutral-800 text-xs font-mono">
        <span class="relative flex h-2 w-2">
          <span id="core-ping-dot" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span id="core-status-dot" class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span id="core-status-text" class="text-neutral-300 text-[11px]">ENGINE: <span class="text-emerald-400 font-medium">CONNECTING...</span></span>
      </div>
    </div>

  </div>
</header>
