---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "SpectraVision AI — Multimodal Deepfake & Synthetic Media Forensics",
	description = "Explainable AI forensic auditing engine cross-examining 2D-FFT frequency spectra, ELA compression residuals, and facial boundary seams."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Open Graph / Social Sharing -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		
		<!-- Google Fonts (Geist Sans & Geist Mono) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-black text-white selection:bg-neutral-800 selection:text-white font-['Geist',sans-serif] min-h-screen flex flex-col justify-between relative bg-grid-pattern">
		<div class="absolute inset-0 bg-radial-gradient pointer-events-none z-0"></div>
		<div class="relative z-10 flex flex-col min-h-screen">
			<slot />
		</div>
	</body>
</html>
