---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Dropzone from '../components/Dropzone.astro';
import ForensicHUD from '../components/ForensicHUD.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="SpectraVision AI — Multimodal Deepfake & Synthetic Media Forensics">
	<Header />
	
	<main class="flex-1 flex flex-col justify-center">
		<Hero />
		<Dropzone />
		<ForensicHUD />
	</main>

	<Footer />
</Layout>

<script>
	import { initForensicClient } from '../scripts/forensicClient';
	
	// Initialize on page load
	document.addEventListener('DOMContentLoaded', () => {
		initForensicClient();
	});
</script>
